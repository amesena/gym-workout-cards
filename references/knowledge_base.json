  "principi": {
    "helms_pyramid": [
      "1. Aderenza: programma sostenibile e realistico prima di tutto.",
      "2. Volume / Intensita' / Frequenza: 10-20 serie dure per gruppo muscolare a settimana (MEV-MAV-MRV).",
      "3. Progressione: modello adatto al livello (novizio=lineare, intermedio=doppia progressione/wave, avanzato=block periodization autoregolato).",
      "4. Selezione esercizi: multiarticolari come base + isolamento per capi muscolari regionali.",
      "5. Recuperi: 2-4 min su multiarticolari pesanti, 60-120s su isolamento.",
      "6. Tempo di esecuzione: secondario, 0.5-6s per ripetizione produce ipertrofia equivalente vicino al cedimento."
    ],
    "rir_rpe_scale": {
      "10_RPE": "0 RIR - cedimento assoluto",
      "9_RPE": "1 RIR",
      "8_RPE": "2 RIR",
      "7_RPE": "3 RIR - riscaldamento/tecnica",
      "target_ipertrofia": "1-3 RIR nella maggior parte delle serie, 0-1 RIR nell'ultima settimana pre-deload",
      "target_forza_heavy": "1-2 RIR sui fondamentali, mai cedimento tecnico su squat/panca/stacco/OHP"
    },
    "volume_settimanale_per_gruppo": {
      "basso": "<10 serie/settimana (novizi o mantenimento)",
      "ottimale": "10-20 serie/settimana (intermedio/avanzato)",
      "nota": "oltre il MRV (massimo volume recuperabile) il ritorno e' negativo per fatica sistemica"
    },
    "frequenza": {
      "principianti": "2-3 sedute full body/settimana",
      "intermedio_avanzato": "2x/settimana per gruppo muscolare (upper/lower, PPL, split specializzati)"
    },
    "recuperi_per_categoria": {
      "multiarticolare_heavy": "2.5-4 min",
      "multiarticolare_hyper": "2-2.5 min",
      "isolamento": "60-120 sec"
    },
    "tempo_esecuzione": {
      "concentrica": "1-2s (esplosiva, intenzione di velocita')",
      "eccentrica": "2-3s (controllata, mantiene tensione meccanica)",
      "nota": "formato notazione: Eccentrica-Pausa_basso-Concentrica-Pausa_alto (es. 2-0-X-0, X=esplosiva)"
    },
    "progressione": {
      "novizio": "Progressione lineare: +1-2.5kg a sessione mantenendo il range di reps target.",
      "intermedio": "Doppia progressione: fissa il carico, sali di reps fino al limite superiore del range, poi aumenta il carico e riparti dal limite inferiore. In alternativa wave/periodizzazione a 3-4 settimane.",
      "avanzato": "Block periodization autoregolato su RIR/velocity loss, con fasi di accumulo/intensificazione/peak.",
      "deload": "Ogni 5-6 settimane: dimezzare le serie totali e usare RIR 3-4 per una settimana."
    },
    "controindicazioni_generali": {
      "lombare": "evitare stacchi/squat heavy senza tecnica validata; preferire leg press, hip thrust, RDL con manubri leggeri, macchine guidate.",
      "ginocchio": "evitare squat profondo/affondi heavy e leg extension pesante; preferire leg press con ROM limitato, hip thrust, adductor/abductor machine.",
      "spalla": "evitare lento avanti dietro la nuca, dip profondi, panca con arco eccessivo; preferire spinte con manubri in traiettoria neutra, cavi, landmine press.",
      "gomito_polso": "evitare curl con bilanciere dritto pesante e French press; preferire curl con manubri/EZ bar, pushdown con corda."
    }
  },

